# Managed by computerConfiguration: selected agent command approvals.
# These approvals apply globally and permit execution outside the sandbox.
# Rules match argument prefixes, so extra arguments are also permitted.

# Selected development commands and Linux diagnostics, shared with Claude.
# Build/test commands execute repository code. Keep journal output finite with -n.

prefix_rule(
    pattern = ["go", "build"],
    decision = "allow",
    match = ["go build ./...", "go build -o /tmp/app ./cmd/app"],
    not_match = ["go install ./..."],
)

prefix_rule(
    pattern = ["go", "test"],
    decision = "allow",
    match = ["go test ./...", "go test -race ./..."],
    not_match = ["go clean -cache"],
)

prefix_rule(
    pattern = ["go", "vet"],
    decision = "allow",
    match = ["go vet ./..."],
    not_match = ["go generate ./..."],
)

prefix_rule(
    pattern = ["go", "version"],
    decision = "allow",
    match = ["go version", "go version -m /tmp/app"],
    not_match = ["go env -w GOPROXY=example"],
)

prefix_rule(
    pattern = [["golangci-lint", "/usr/bin/golangci-lint"]],
    decision = "allow",
    match = [
        "golangci-lint run ./...",
        "golangci-lint run --timeout 5m --config .golangci.yml ./...",
        "golangci-lint --verbose run --fix ./internal/...",
        "golangci-lint version",
        "/usr/bin/golangci-lint run --build-tags integration ./...",
    ],
    not_match = ["golangci-lint-custom run ./...", "sudo golangci-lint run ./..."],
)

prefix_rule(
    pattern = ["npm", "run", ["build", "check"]],
    decision = "allow",
    match = ["npm run build", "npm run check", "npm run build -- --mode production"],
    not_match = ["npm run deploy", "npm install", "npm publish"],
)

prefix_rule(
    pattern = ["npm", "run", "lint"],
    decision = "allow",
    match = ["npm run lint", "npm run lint -- --quiet"],
    not_match = ["npm install"],
)

prefix_rule(
    pattern = ["npm", "run", "type-check"],
    decision = "allow",
    match = ["npm run type-check"],
    not_match = ["npm run typecheck"],
)

prefix_rule(
    pattern = ["npm", "run", "unit"],
    decision = "allow",
    match = ["npm run unit", "npm run unit -- --run"],
    not_match = ["npm run integration"],
)

prefix_rule(
    pattern = ["uv", "run", "pytest"],
    decision = "allow",
    match = ["uv run pytest", "uv run pytest -q tests"],
    not_match = ["uv run python script.py", "uv sync"],
)

prefix_rule(
    pattern = ["journalctl", "-b", "--no-pager", "-n"],
    decision = "allow",
    match = ["journalctl -b --no-pager -n 200", "journalctl -b --no-pager -n 50 --since today"],
    not_match = ["journalctl -f", "journalctl --vacuum-time=1d"],
)

prefix_rule(
    pattern = ["journalctl", "--list-boots"],
    decision = "allow",
    match = ["journalctl --list-boots", "journalctl --list-boots --no-pager"],
    not_match = ["journalctl --rotate"],
)

prefix_rule(
    pattern = ["ip", "-br", "address", "show"],
    decision = "allow",
    match = ["ip -br address show", "ip -br address show dev lo"],
    not_match = ["ip -br address flush dev lo"],
)

prefix_rule(
    pattern = ["ip", "-br", "link", "show"],
    decision = "allow",
    match = ["ip -br link show", "ip -br link show dev lo"],
    not_match = ["ip -br link set dev lo down"],
)

prefix_rule(
    pattern = ["ip", "-6", "address", "show"],
    decision = "allow",
    match = ["ip -6 address show", "ip -6 address show dev lo"],
    not_match = ["ip -6 address add ::1/128 dev lo"],
)

prefix_rule(
    pattern = ["ip", "-6", "route", "show"],
    decision = "allow",
    match = ["ip -6 route show", "ip -6 route show table all"],
    not_match = ["ip -6 route delete default"],
)

prefix_rule(
    pattern = ["ip", "-6", "route", "get"],
    decision = "allow",
    match = ["ip -6 route get ::1"],
    not_match = ["ip -6 route add default via ::1"],
)

prefix_rule(
    pattern = ["ip", "route", "show"],
    decision = "allow",
    match = ["ip route show", "ip route show table all"],
    not_match = ["ip route delete default"],
)

prefix_rule(
    pattern = ["ip", "route", "get"],
    decision = "allow",
    match = ["ip route get 127.0.0.1"],
    not_match = ["ip route add default via 127.0.0.1"],
)

prefix_rule(
    pattern = ["ip", "rule", "show"],
    decision = "allow",
    match = ["ip rule show"],
    not_match = ["ip rule add priority 100 table main"],
)

prefix_rule(
    pattern = ["resolvectl", "status"],
    decision = "allow",
    match = ["resolvectl status", "resolvectl status lo"],
    not_match = ["resolvectl dns lo 1.1.1.1"],
)

prefix_rule(
    pattern = ["getent", "hosts"],
    decision = "allow",
    match = ["getent hosts localhost"],
    not_match = ["getent passwd"],
)

prefix_rule(
    pattern = ["systemctl", "--user", "status"],
    decision = "allow",
    match = ["systemctl --user status", "systemctl --user status example.service --no-pager"],
    not_match = ["systemctl --user restart example.service"],
)

prefix_rule(
    pattern = ["systemctl", "--user", "cat"],
    decision = "allow",
    match = ["systemctl --user cat example.service"],
    not_match = ["systemctl --user edit example.service"],
)

# From linux/ansible/.claude/settings.local.json.
prefix_rule(
    pattern = ["nvim", "--version"],
    decision = "allow",
    match = ["nvim --version"],
    not_match = ["nvim --headless", "nvim --cmd 'echo 1' --version"],
)

prefix_rule(
    pattern = ["tree-sitter", "--version"],
    decision = "allow",
    match = ["tree-sitter --version"],
    not_match = ["tree-sitter generate", "tree-sitter build"],
)

prefix_rule(
    pattern = ["/bin/ls"],
    decision = "allow",
    match = ["/bin/ls /usr/lib", "/bin/ls -la"],
    not_match = ["rm -rf /tmp/example", "ls /usr/lib"],
)

# From the website project's .claude/settings.local.json; approved globally.
# Build scripts execute package-defined commands and may write outside the workspace.
prefix_rule(
    pattern = ["pnpm", "build"],
    decision = "allow",
    match = ["pnpm build", "pnpm build --verbose"],
    not_match = ["pnpm install", "pnpm publish", "pnpm run build"],
)

# Stage paths without opening an editor or accepting additional options.
# Git may still execute configured clean filters.
prefix_rule(
    pattern = ["git", "add", "--"],
    decision = "allow",
    match = ["git add -- src/file.py"],
    not_match = ["git add --edit", "git add --force src/file.py", "git reset --hard"],
)

prefix_rule(
    pattern = ["git", "add", ["-A", "-u"], "--"],
    decision = "allow",
    match = ["git add -A --", "git add -u -- src/file.py"],
    not_match = ["git add -A --edit", "git add -u --force src/file.py"],
)

# Repository inspection. Do not allow all of git, worktree or remote.
prefix_rule(
    pattern = ["git", ["status", "ls-files", "ls-tree", "rev-parse", "rev-list", "describe"]],
    decision = "allow",
    match = [
        "git status --short", "git ls-files", "git ls-tree HEAD",
        "git rev-parse HEAD", "git rev-list --count HEAD", "git describe --always",
    ],
    not_match = ["git reset --hard", "git clean -fd", "git diff --output=/tmp/diff"],
)

prefix_rule(
    pattern = ["git", "worktree", "list"],
    decision = "allow",
    match = ["git worktree list", "git worktree list --porcelain"],
    not_match = ["git worktree remove /tmp/worktree", "git worktree prune"],
)

prefix_rule(
    pattern = ["git", "remote", "get-url"],
    decision = "allow",
    match = ["git remote get-url origin", "git remote get-url --all origin"],
    not_match = ["git remote remove origin", "git remote set-url origin example"],
)

# Prefer fast-forward pulls for routine updates. This is a prefix approval,
# not an argument validator: trailing options can override --ff-only, and
# explicit refspecs can update other local refs. Plain pull/fetch stay unapproved.
prefix_rule(
    pattern = ["git", "pull", "--ff-only"],
    decision = "allow",
    match = ["git pull --ff-only", "git pull --ff-only origin main"],
    not_match = ["git pull", "git pull --rebase", "git fetch", "git reset --hard"],
)

# Read pull requests, CI runs and releases without approving publication.
prefix_rule(
    pattern = ["gh", "pr", ["view", "list", "diff", "checks"]],
    decision = "allow",
    match = ["gh pr view 1", "gh pr list", "gh pr diff 1", "gh pr checks 1"],
    not_match = ["gh pr merge 1", "gh pr create", "gh pr comment 1 --body example"],
)

prefix_rule(
    pattern = ["gh", "run", ["view", "list"]],
    decision = "allow",
    match = ["gh run view 1 --log", "gh run list"],
    not_match = ["gh run cancel 1", "gh run rerun 1", "gh run delete 1"],
)

prefix_rule(
    pattern = ["gh", "repo", "view"],
    decision = "allow",
    match = ["gh repo view", "gh repo view owner/repo"],
    not_match = ["gh repo delete owner/repo", "gh repo edit --visibility public"],
)

prefix_rule(
    pattern = ["gh", "release", ["view", "list"]],
    decision = "allow",
    match = ["gh release view v1.0", "gh release list"],
    not_match = ["gh release create v1.0", "gh release delete v1.0"],
)

prefix_rule(
    pattern = ["glab", "mr", ["view", "list", "diff"]],
    decision = "allow",
    match = ["glab mr view 1", "glab mr list", "glab mr diff 1"],
    not_match = ["glab mr merge 1", "glab mr create", "glab mr note 1 -m example"],
)

# Build/test commands execute project code outside the sandbox.
prefix_rule(
    pattern = ["pnpm", "run", ["build", "check"]],
    decision = "allow",
    match = ["pnpm run build", "pnpm run check", "pnpm run build -- --mode production"],
    not_match = ["pnpm run deploy", "pnpm install", "pnpm publish"],
)

prefix_rule(
    pattern = ["bun", "run", ["build", "check"]],
    decision = "allow",
    match = ["bun run build", "bun run check", "bun run build -- --mode production"],
    not_match = ["bun run deploy", "bun install", "bun publish", "bun build src/index.ts"],
)

prefix_rule(
    pattern = ["python3", "-m", "unittest"],
    decision = "allow",
    match = ["python3 -m unittest", "python3 -m unittest discover -s tests -v"],
    not_match = ["python3 -m pip install example", "python3 -c 'print(1)'"],
)
