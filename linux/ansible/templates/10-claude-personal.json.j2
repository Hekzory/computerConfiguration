{# Personal Claude Code policy, shipped as a managed-settings.d drop-in.
   Deliberately NOT ~/.claude/settings.json: that file holds API tokens and proxy
   env, so it stays off git entirely. Policy settings outrank user and project
   ones, so the no-attribution rule can't be flipped by a stray /config or a
   per-repo settings file. A drop-in rather than managed-settings.json itself so
   an employer-managed policy file can coexist — Claude reads the base file
   first, then merges .d/*.json over it in name order.
   Keep only policy here: model, effort and friends belong in the user file,
   where /model and /effort can still write to them.
   Prompt suggestions are policy too: each one is an extra request on the main
   model over the whole context, after every turn, billed to the subscription,
   and it's rarely worth the Tab. Here /config can't quietly turn them back on.
   Session recap is the same kind of hidden request, fired on every return after
   a few minutes away.
   The Claude Docs connector comes with the claude.ai account and adds its
   instructions and tools to every request; it is denied by name, so a connector
   added on claude.ai later still loads. Claude Code joins deniedMcpServers from
   every policy source, so an employer's list keeps its entries.
   The skill listing rides on every request too. Built-ins you start yourself
   (/code-review, /init …) are kept out of the model's view and still run as
   /name; claude.ai's file-format and research skills are listed by name only;
   the desktop-app skills, the one-time memory import and docs (it needs the
   denied connector) are off. skillOverrides is keyed by bare name: a personal or
   project skill must not reuse one of these names (a plugin's skills are
   namespaced, plugin:name, and stay untouched). /skills can't flip them: they are
   policy, changed here.
   The Bash tool runs bash, not zsh. Without an override Claude Code takes zsh
   here (the login shell is fish, which it can't drive), and zsh trips on the
   bash the model writes: an unquoted glob that matches nothing aborts the
   command, a word starting with = is looked up as a program, an unquoted $var
   isn't split into words.
   ssh-fish-guard catches bash syntax sent over ssh: this playbook makes fish the
   login shell everywhere, and sshd runs a remote command in it, so a remote
   `f=x; for …; do` or a heredoc piped to plain `ssh host` dies there. The fix it
   names is `ssh host bash -s <<'EOF'`.
   Selected command approvals travel with this policy too. Builds and tests
   execute repository code, including pnpm build; this is a deliberate allowance,
   not a general shell, npx, Git-write or sudo approval. Network diagnostics name
   read subcommands rather than ip-wide prefixes. Journal reads use a finite -n
   limit and --no-pager, as the separately managed diagnostic instructions say. #}
{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go version)",
      "Bash(npm run build *)",
      "Bash(npm run lint *)",
      "Bash(npm run type-check *)",
      "Bash(npm run unit *)",
      "Bash(uv run pytest *)",
      "Bash(journalctl -b --no-pager -n *)",
      "Bash(journalctl --list-boots)",
      "Bash(ip -br address show *)",
      "Bash(ip -br link show *)",
      "Bash(ip -6 address show *)",
      "Bash(ip -6 route show *)",
      "Bash(ip -6 route get *)",
      "Bash(ip route show *)",
      "Bash(ip route get *)",
      "Bash(ip rule show *)",
      "Bash(resolvectl status *)",
      "Bash(getent hosts *)",
      "Bash(systemctl --user status *)",
      "Bash(systemctl --user cat *)",
      "Bash(nvim --version *)",
      "Bash(tree-sitter --version *)",
      "Bash(/bin/ls *)",
      "Bash(pnpm build *)"
    ]
  },
  "deniedMcpServers": [
    { "serverName": "claude.ai Claude Docs" }
  ],
  "skillOverrides": {
    "code-review": "user-invocable-only",
    "security-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "init": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "docx": "name-only",
    "pptx": "name-only",
    "xlsx": "name-only",
    "pdf": "name-only",
    "deep-research": "name-only",
    "chrome-browser": "name-only",
    "computer-use": "off",
    "built-in-browser": "off",
    "import-memory": "off",
    "docs": "off"
  },
  "statusLine": {
    "type": "command",
    "command": "{{ user_home }}/.claude/statusline.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{ user_home }}/.claude/hooks/git-guard.sh"
          },
          {
            "type": "command",
            "command": "python3 {{ user_home }}/.claude/hooks/ssh-fish-guard.py"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_SHELL": "/usr/bin/bash"
  }
}
