# Managed by Ansible (arch-core.yml) — edit templates/10-journald-limits.conf.j2
[Journal]
SystemMaxUse=256M
SystemMaxFileSize=32M
{% if is_wsl | bool %}
# WSL never persists journald's offline state on shutdown, so every boot
# abandons an 8M file and starts a fresh one. Bare metal shuts down cleanly
# and doesn't leak files like this, so the cap stays WSL-only.
SystemMaxFiles=8
{% endif %}
