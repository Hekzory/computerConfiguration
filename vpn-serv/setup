#!/usr/bin/env python3
"""Configure an Ubuntu VPN host using its existing SSH access."""
import argparse
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys
import tempfile
import threading


class RemoteFailure(RuntimeError):
    """The useful error has already been printed by the remote worker."""


class Reporter:
    def __init__(self, verbose=False, color=False):
        self.verbose = verbose
        self.color = color
        self.counts = {}

    def event(self, event):
        status = event['status']
        if status in {'OK', 'CHANGED', 'PLAN', 'WARN', 'ERROR'}:
            self.counts[status] = self.counts.get(status, 0) + 1
        if not self.verbose and status in {'OK', 'DETAIL'}:
            return
        labels = {'OK': ('32', '✓'), 'CHANGED': ('36', '✓'), 'PLAN': ('33', '→'),
                  'WARN': ('33', '!'), 'ERROR': ('31', '✗')}
        color, label = labels.get(status, ('0', '·'))
        if self.color:
            label = f'\033[{color}m{label}\033[0m'
        print(f'{label} {event["message"]}', flush=True)

    def summary(self):
        names = {'CHANGED': 'Изменено', 'OK': 'Уже настроено', 'PLAN': 'В плане',
                 'WARN': 'Предупреждений', 'ERROR': 'Ошибок'}
        print(' · '.join(f'{label}: {self.counts[key]}' for key, label in names.items()
                         if self.counts.get(key)) or 'Изменений нет')


def parser():
    p = argparse.ArgumentParser(description=__doc__, epilog=(
        'Requires Python 3 and root or passwordless sudo on Ubuntu. Uses existing SSH '
        'keys/config. Defaults: journal limits, BBR, fq_codel, TCP SYN cookies, '
        'MTU probing and fs.file-max=2097152. '
        'Does not install Amnezia or restart Docker. Package removal requires interactive '
        'confirmation; service disabling does not. No autoremove. Backups: /var/backups/vpn-serv. '
        'Use "setup set login@address" to save a default host beside this script.'))
    p.add_argument('host', nargs='?', help='login@address or an SSH alias; defaults to the saved host')
    mode = p.add_mutually_exclusive_group()
    mode.add_argument('--check', action='store_true', help='preview changes')
    mode.add_argument('--audit', action='store_true', help='inspect the host without changes')
    p.add_argument('--debloat', action='store_true', help='disable optional VPS services and offer package removal')
    p.add_argument('-v', '--verbose', action='store_true', help='show unchanged settings and diagnostic details')
    p.add_argument('-p', '--port', type=int)
    p.add_argument('-i', '--identity', help='SSH identity file (otherwise use SSH config/agent)')
    return p


def main():
    saved_host = Path(__file__).resolve().with_name('.last-host')

    def validate(host, cli):
        if not host or host.startswith('-') or any(c.isspace() or ord(c) < 32 for c in host):
            cli.error('invalid SSH destination')
        return host

    if sys.argv[1:2] == ['set']:
        cli = argparse.ArgumentParser(prog=f'{sys.argv[0]} set', description='Save the default SSH host locally, without connecting.')
        cli.add_argument('host', help='login@address or an SSH config alias')
        host = validate(cli.parse_args(sys.argv[2:]).host, cli)
        fd, temporary = tempfile.mkstemp(prefix='.last-host-', dir=saved_host.parent)
        try:
            with os.fdopen(fd, 'w') as stream:
                stream.write(host + '\n')
            os.replace(temporary, saved_host)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
        print(f'Адрес сохранён: {host} ({saved_host})')
        return

    cli = parser()
    args = cli.parse_args()
    if args.host is None:
        try:
            args.host = saved_host.read_text().removesuffix('\n')
        except FileNotFoundError:
            cli.error('specify a host or save one with: setup set login@address')
    validate(args.host, cli)
    if args.port is not None and not 1 <= args.port <= 65535:
        parser().error('port must be between 1 and 65535')
    ssh = ['ssh', '-T', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=15',
           '-o', 'ServerAliveInterval=15', '-o', 'ServerAliveCountMax=3']
    if args.port:
        ssh += ['-p', str(args.port)]
    if args.identity:
        ssh += ['-i', args.identity]
    source = Path(__file__).with_name('remote.py').read_text()
    color = sys.stdout.isatty() and 'NO_COLOR' not in os.environ
    reporter = Reporter(args.verbose, color)

    def run(config):
        # sh is explicit: the user's remote login shell may be fish.
        command = 'python3 - ' + shlex.quote(json.dumps(config))
        script = ('command -v python3 >/dev/null || { echo "Python 3 is required on the server" >&2; exit 1; }; '
                  'if [ "$(id -u)" = 0 ]; then exec ' + command +
                  '; else exec sudo -n ' + command + '; fi')
        process = subprocess.Popen(ssh + [args.host, 'sh -c ' + shlex.quote(script)],
                                   stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
        expired = threading.Event()

        def stop():
            expired.set()
            process.kill()

        timer = threading.Timer(300, stop)
        timer.daemon = True
        timer.start()
        plan = []
        remote_error = False
        try:
            try:
                process.stdin.write(source)
                process.stdin.close()
            except BrokenPipeError:
                pass  # SSH's exit status explains connection/preflight failures.
            for line in process.stdout:
                try:
                    event = json.loads(line)
                except json.JSONDecodeError:
                    print(line.rstrip(), flush=True)
                    continue
                if event['status'] == 'PACKAGES':
                    plan = event['packages']
                    continue
                remote_error = remote_error or event['status'] == 'ERROR'
                reporter.event(event)
            process.wait()
            if expired.is_set():
                raise subprocess.TimeoutExpired(ssh, 300)
            if process.returncode:
                if remote_error:
                    raise RemoteFailure()
                raise RuntimeError(f'SSH/remote task exited with {process.returncode}')
        finally:
            timer.cancel()
            if process.poll() is None:
                process.kill()
            process.wait()
            process.stdout.close()
            try:
                process.stdin.close()
            except BrokenPipeError:
                pass
        return plan

    print(f'Ubuntu VPS → {args.host}', flush=True)
    mode = 'audit' if args.audit else 'check' if args.check else 'apply'
    plan = run({'mode': mode, 'debloat': args.debloat})
    if plan and args.debloat and mode == 'apply':
        print('Удалить перечисленные пакеты: ' + ', '.join(plan))
        if sys.stdin.isatty() and input('Введите yes для удаления: ').strip() == 'yes':
            run({'mode': 'purge', 'packages': plan})
        else:
            print('Удаление пропущено. Настройки и службы уже обработаны.')
    reporter.summary()


if __name__ == '__main__':
    try:
        main()
    except RemoteFailure:
        sys.exit(1)
    except subprocess.TimeoutExpired:
        print('[ERROR] SSH timed out. The remote operation may still be running; '
              'inspect the host before retrying.', file=sys.stderr)
        sys.exit(1)
    except (RuntimeError, OSError) as exc:
        print(f'[ERROR] {exc}', file=sys.stderr)
        sys.exit(1)
    except (KeyboardInterrupt, EOFError):
        print('\nОстановлено.', file=sys.stderr)
        sys.exit(130)
