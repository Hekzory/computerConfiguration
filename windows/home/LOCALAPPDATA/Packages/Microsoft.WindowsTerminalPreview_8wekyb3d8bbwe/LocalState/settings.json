{
    // Deployed by arch-core from WSL (windows/home in the repo). The settings UI
    // saves here too, and the next run puts the repo's version back: change it there.
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema-preview",
    "actions":
    [
        {
            "command":
            {
                "action": "copy",
                "singleLine": false
            },
            "id": "User.copy.644BA8F2"
        },
        {
            "command":
            {
                "action": "scrollToMark",
                "direction": "next"
            },
            "id": "User.scrollToMark.next"
        },
        {
            "command": "paste",
            "id": "User.paste"
        },
        {
            "command":
            {
                "action": "splitPane",
                "split": "auto",
                "splitMode": "duplicate"
            },
            "id": "User.splitPane.A6751878"
        },
        {
            "command": "find",
            "id": "User.find"
        },
        {
            "command":
            {
                "action": "scrollToMark",
                "direction": "previous"
            },
            "id": "User.scrollToMark.previous"
        },
        {
            "command":
            {
                "action": "selectOutput",
                "direction": "prev"
            },
            "id": "User.selectOutput.prev"
        },
        {
            "command":
            {
                "action": "selectCommand",
                "direction": "prev"
            },
            "id": "User.selectCommand.prev"
        }
    ],
    "centerOnLaunch": true,
    "compatibility.enableUnfocusedAcrylic": false,
    "copyFormatting": "none",
    "copyOnSelect": false,
    "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
    "disabledProfileSources":
    [
        "Windows.Terminal.Azure",
        "Windows.Terminal.VisualStudio",
        "Windows.Terminal.SSH"
    ],
    "keybindings":
    [
        {
            "id": "User.copy.644BA8F2",
            "keys": "ctrl+c"
        },
        {
            "id": "User.selectOutput.prev",
            "keys": "ctrl+shift+o"
        },
        {
            "id": "User.paste",
            "keys": "ctrl+v"
        },
        {
            "id": "User.find",
            "keys": "ctrl+shift+f"
        },
        {
            "id": "User.splitPane.A6751878",
            "keys": "alt+shift+d"
        },
        {
            "id": "User.scrollToMark.next",
            "keys": "ctrl+down"
        },
        {
            "id": "User.scrollToMark.previous",
            "keys": "ctrl+up"
        }
    ],
    "language": "ru",
    "newTabMenu":
    [
        {
            "type": "remainingProfiles"
        }
    ],
    "profiles":
    {
        "defaults":
        {
            "colorScheme": "Tokyo Night Moon",
            "compatibility.allowDECRQCRA": true,
            "compatibility.allowOSC777": true,
            // Terminal draws 24-bit color but never says so. WSL can't see this
            // (WSLENV only forwards WT_SESSION), so config.fish sets it there.
            "environment":
            {
                "COLORTERM": "truecolor"
            },
            "font":
            {
                "face": "FiraCode Nerd Font Mono"
            },
            "useAcrylic": false
        },
        "list":
        [
            {
                "commandline": "%SystemRoot%\\System32\\cmd.exe",
                "guid": "{0caa0dad-35be-5f56-a8ff-afceeeaa6101}",
                "hidden": true,
                "name": "Command Prompt"
            },
            {
                "cursorShape": "emptyBox",
                "elevate": true,
                "experimental.retroTerminalEffect": false,
                "guid": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
                "hidden": false,
                "name": "PowerShell",
                "opacity": 98,
                "source": "Windows.Terminal.PowershellCore",
                "useAcrylic": true
            },
            {
                "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
                "hidden": true,
                "name": "Windows PowerShell"
            },
            {
                "antialiasingMode": "cleartype",
                "cursorShape": "emptyBox",
                "experimental.retroTerminalEffect": false,
                "guid": "{a5a97cb8-8961-5535-816d-772efe0c6a3f}",
                "hidden": false,
                "name": "Arch",
                "opacity": 98,
                "showMarksOnScrollbar": true,
                "source": "Windows.Terminal.Wsl",
                "useAcrylic": true
            },
            {
                "guid": "{b453ae62-4e3d-5e58-b989-0a998ec441b8}",
                "hidden": true,
                "name": "Azure Cloud Shell",
                "source": "Windows.Terminal.Azure"
            },
            {
                "guid": "{2ece5bfe-50ed-5f3a-ab87-5cd4baafed2b}",
                "hidden": false,
                "name": "Git Bash",
                "source": "Git"
            },
            {
                "guid": "{c3c14ad8-cbe3-546d-a957-7ed0daf6aa65}",
                "hidden": false,
                "name": "Developer Command Prompt for VS 2022",
                "source": "Windows.Terminal.VisualStudio"
            },
            {
                "guid": "{9618129a-c301-5cf2-ada0-d9d73540e778}",
                "hidden": false,
                "name": "Developer PowerShell for VS 2022",
                "source": "Windows.Terminal.VisualStudio"
            }
        ]
    },
    "rendering.graphicsAPI": "direct3d11",
    "schemes":
    [
        {
            "background": "#222436",
            "black": "#1B1D2B",
            "blue": "#82AAFF",
            "brightBlack": "#444A73",
            "brightBlue": "#82AAFF",
            "brightCyan": "#86E1FC",
            "brightGreen": "#C3E88D",
            "brightPurple": "#FCA7EA",
            "brightRed": "#FF757F",
            "brightWhite": "#C8D3F5",
            "brightYellow": "#FFC777",
            "cursorColor": "#C8D3F5",
            "cyan": "#86E1FC",
            "foreground": "#C8D3F5",
            "green": "#C3E88D",
            "name": "Tokyo Night Moon",
            "purple": "#C099FF",
            "red": "#FF757F",
            "selectionBackground": "#2D3F76",
            "white": "#828BB8",
            "yellow": "#FFC777"
        }
    ],
    "themes": [],
    "useAcrylicInTabRow": true
}